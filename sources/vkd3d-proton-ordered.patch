diff --git a/libs/vkd3d/nr_ordered.h b/libs/vkd3d/nr_ordered.h
new file mode 100644
index 0000000..893542c
--- /dev/null
+++ b/libs/vkd3d/nr_ordered.h
@@ -0,0 +1,48 @@
+/* Versioned ABI shared by the native HIP bridge and the vkd3d PE/native client.
+ * Fixed-width fields only. Every function pointer uses the Unix x86_64 ABI.
+ * No GPU waits are issued by this table; the producer must first finish its
+ * already-submitted Vulkan command buffer before publishing input readiness.
+ */
+#ifndef DLSSNR_ORDERED_H
+#define DLSSNR_ORDERED_H
+#include <stdint.h>
+#define NR_ORDERED_ENV "DLSSNR_ORDERED_ABI_V3"
+#define NR_ORDERED_MAGIC UINT64_C(0x3144524f524e4c44)
+#define NR_ORDERED_VERSION 3u
+#define NR_ORDERED_MAX_RESOURCES 128u
+#define NR_ORDERED_WINDOW 8u
+#if defined(__x86_64__) || defined(_M_X64)
+#define NR_SYSV __attribute__((sysv_abi))
+#else
+#define NR_SYSV
+#endif
+/* try_retain runs under registry mutex: CAS nonzero only, no reentry.
+ * release runs outside it. Registry holds no owning reference. */
+typedef int (NR_SYSV *nr_try_retain_fn)(uint64_t owner);
+typedef void (NR_SYSV *nr_release_fn)(uint64_t owner);
+struct nr_buffer {
+    uint64_t token, buffer, size;
+    uint64_t owner;
+    nr_release_fn release;
+};
+struct nr_ordered_api {
+    uint64_t magic;
+    uint32_t version, bytes;
+    int (NR_SYSV *register_resource)(uint64_t device, uint64_t handle, uint64_t va,
+            uint64_t buffer, uint64_t size, uint64_t owner,
+            nr_try_retain_fn try_retain, nr_release_fn release, uint64_t *token);
+    int (NR_SYSV *lookup_va)(uint64_t device, uint64_t va, uint64_t *token);
+    /* Success transfers one pin per entry; failure returns count=0 and rolls back. */
+    int (NR_SYSV *snapshot)(uint64_t device, struct nr_buffer *out, uint32_t capacity, uint32_t *count);
+    /* All-or-none permanent logical queue affinity until resource retirement.
+     * Queue IDs must be nonzero, unique, never reused; call BEFORE any prefix. */
+    int (NR_SYSV *claim_queue)(const struct nr_buffer *buffers, uint32_t count, uint64_t queue);
+    int (NR_SYSV *retire_resource)(uint64_t device, uint64_t va);
+    /* Independent HIP pins for EXACT producer barriers; caller keeps its pins. */
+    int (NR_SYSV *publish_input)(uint64_t token, uint32_t frame,
+            const struct nr_buffer *exact_snapshot, uint32_t count);
+    int (NR_SYSV *wait_output)(uint64_t token, uint32_t frame, uint32_t timeout_ms);
+    int (NR_SYSV *consumer_submitted)(uint64_t token, uint32_t frame);
+    int (NR_SYSV *fail)(uint64_t token, uint32_t frame, int error);
+};
+#endif
diff --git a/libs/vkd3d/nr_ordered_client.h b/libs/vkd3d/nr_ordered_client.h
new file mode 100644
index 0000000..541316d
--- /dev/null
+++ b/libs/vkd3d/nr_ordered_client.h
@@ -0,0 +1,146 @@
+/* Optional DLSS-NR rendezvous. Inactive unless a versioned native bridge is
+ * present and VKD3D_NR_FLAG_HASH identifies the exact flag compute shader. */
+#ifndef VKD3D_NR_ORDERED_CLIENT_H
+#define VKD3D_NR_ORDERED_CLIENT_H
+#include "nr_ordered.h"
+
+/* Diagnostic only: a fixed event budget avoids a per-frame log flood. */
+static inline bool nr_ordered_diagnostics_enabled(void)
+{
+    char enabled[8];
+    return vkd3d_get_env_var("DLSSNR_DIAGNOSTICS", enabled, sizeof(enabled)) && !strcmp(enabled, "1");
+}
+
+static inline bool nr_ordered_trace_allowed(void)
+{
+    static LONG count;
+    LONG n;
+    if (!nr_ordered_diagnostics_enabled())
+        return false;
+    do
+    {
+        n = InterlockedCompareExchange(&count, 0, 0);
+        if (n >= 128)
+            return false;
+    } while (InterlockedCompareExchange(&count, n + 1, n) != n);
+    return true;
+}
+
+static inline void nr_ordered_trace_list(const char *stage, const struct d3d12_command_list *list)
+{
+    uint32_t i;
+    for (i = 0; i < list->cmd.iteration_count; ++i)
+    {
+        const struct nr_ordered_boundary *b = &list->cmd.iterations[i].nr_after;
+        if ((b->nr_producer.token || b->nr_consumer.token) && nr_ordered_trace_allowed())
+            INFO("NRDIAG stage=%s list=%p iteration=%u producer=%"PRIu64"/%u consumer=%"PRIu64"/%u recording=%u.\n",
+                    stage, list, i, b->nr_producer.token, b->nr_producer.frame,
+                    b->nr_consumer.token, b->nr_consumer.frame, list->is_recording);
+    }
+}
+
+/* Observational state for an earlier task that may block an NR execute.
+ * Strings have static lifetime. Reads are atomic, but fields can straddle a
+ * worker transition: these snapshots are diagnostic hints, not synchronization.
+ */
+static inline void nr_ordered_queue_phase(struct d3d12_command_queue *queue,
+        const char *phase, void *fence, uint64_t value)
+{
+    if (!queue->nr_diagnostics)
+        return;
+    InterlockedExchangePointer(&queue->nr_diag_fence, fence);
+    InterlockedExchange64(&queue->nr_diag_value, value);
+    InterlockedExchangePointer(&queue->nr_diag_phase, (void *)phase);
+}
+
+static inline void nr_ordered_trace_execute(const char *stage, struct d3d12_command_queue *queue,
+        const struct d3d12_command_queue_submission_execute *exec)
+{
+    const char *phase;
+    uint32_t i;
+    if (!queue->nr_diagnostics)
+        return;
+    for (i = 0; exec->nr_boundaries && i < exec->cmd_count; ++i)
+    {
+        const struct nr_ordered_boundary *b = &exec->nr_boundaries[i];
+        if (!b->nr_producer.token && !b->nr_consumer.token)
+            continue;
+        if (!nr_ordered_trace_allowed())
+            return;
+        phase = InterlockedCompareExchangePointer(&queue->nr_diag_phase, NULL, NULL);
+        INFO("NRDIAG stage=%s queue=%p producer=%"PRIu64"/%u consumer=%"PRIu64"/%u worker=%s fence=%p value=%"PRIu64".\n",
+                stage, queue, b->nr_producer.token, b->nr_producer.frame,
+                b->nr_consumer.token, b->nr_consumer.frame, phase ? phase : "init",
+                InterlockedCompareExchangePointer(&queue->nr_diag_fence, NULL, NULL),
+                (uint64_t)InterlockedCompareExchange64(&queue->nr_diag_value, 0, 0));
+        return;
+    }
+}
+
+
+static inline struct nr_ordered_api *nr_ordered_get_api(void)
+{
+    struct nr_ordered_api *api;
+    const char *text;
+    char buf[64], *end;
+    unsigned long long address;
+#ifdef _WIN32
+    typedef int (WINAPI *unix_env_fn)(const char *, char *, uint64_t);
+    unix_env_fn unix_env;
+    HMODULE ntdll = GetModuleHandleA("ntdll.dll");
+    unix_env = ntdll ? (unix_env_fn)GetProcAddress(ntdll, "__wine_get_unix_env") : NULL;
+    if (!unix_env || unix_env(NR_ORDERED_ENV, buf, sizeof(buf)) || !buf[0])
+        return NULL;
+    text = buf;
+#else
+    (void)buf;
+    text = getenv(NR_ORDERED_ENV);
+#endif
+    if (!text || !*text)
+        return NULL;
+    address = strtoull(text, &end, 0);
+    if (!address || *end)
+        return NULL;
+    api = (struct nr_ordered_api *)(uintptr_t)address;
+    if (api->magic != NR_ORDERED_MAGIC || api->version != NR_ORDERED_VERSION || api->bytes != sizeof(*api))
+        return NULL;
+    return api;
+}
+static int NR_SYSV nr_ordered_try_retain(uint64_t owner)
+{
+    struct d3d12_resource *r = (void *)(uintptr_t)owner;
+    LONG refs = InterlockedCompareExchange(&r->internal_refcount, 0, 0), previous;
+    /* Destructor retires under the same registry mutex before freeing r. */
+    while (refs > 0 && refs < INT_MAX)
+    {
+        previous = InterlockedCompareExchange(&r->internal_refcount, refs + 1, refs);
+        if (previous == refs)
+        {
+            /* A HIP-owned pin may outlive every allocator/app reference.
+             * Internal resource refs alone do not retain the Vulkan device. */
+            d3d12_device_add_ref(r->device);
+            return 0;
+        }
+        refs = previous;
+    }
+    return 1;
+}
+static void NR_SYSV nr_ordered_release(uint64_t owner)
+{
+    struct d3d12_resource *r = (void *)(uintptr_t)owner;
+    struct d3d12_device *device = r->device;
+    d3d12_resource_decref(r);
+    d3d12_device_release(device);
+}
+static inline void nr_ordered_register_shared(struct d3d12_resource *r, uint64_t handle)
+{
+    struct nr_ordered_api *api = nr_ordered_get_api();
+    uint64_t token;
+    if (api && handle && d3d12_resource_is_buffer(r) && (r->heap_flags & D3D12_HEAP_FLAG_SHARED))
+        if (api->register_resource((uint64_t)(uintptr_t)r->device, handle, r->res.va,
+                (uint64_t)(uintptr_t)r->res.vk_buffer, r->desc.Width,
+                (uint64_t)(uintptr_t)r, nr_ordered_try_retain, nr_ordered_release, &token))
+            d3d12_device_mark_as_removed(r->device, DXGI_ERROR_DEVICE_REMOVED,
+                    "NR: failed to register shared resource lifetime.\n");
+}
+#endif
diff --git a/libs/vkd3d/nr_ordered_commands.h b/libs/vkd3d/nr_ordered_commands.h
new file mode 100644
index 0000000..43975fa
--- /dev/null
+++ b/libs/vkd3d/nr_ordered_commands.h
@@ -0,0 +1,273 @@
+/* Included in command.c after command-list split helpers are defined.
+ * Never waits during command recording or in the ECL API entry point. */
+static bool nr_ordered_memory_barrier(struct d3d12_command_list *list,
+        const struct nr_ordered_snapshot *snapshot, bool release)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    const struct nr_buffer *buffers = snapshot->buffers;
+    VkBufferMemoryBarrier2 barriers[NR_ORDERED_MAX_RESOURCES];
+    VkDependencyInfo d = { VK_STRUCTURE_TYPE_DEPENDENCY_INFO };
+    uint32_t n = snapshot->count, i;
+    if (!n || n > NR_ORDERED_MAX_RESOURCES || !list->cmd.vk_command_buffer)
+        return false;
+    memset(barriers, 0, sizeof(barriers));
+    for (i = 0; i < n; ++i)
+    {
+        barriers[i].sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER_2;
+        barriers[i].srcStageMask = release ? VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT : VK_PIPELINE_STAGE_2_NONE;
+        barriers[i].srcAccessMask = release ? VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT : 0;
+        barriers[i].dstStageMask = release ? VK_PIPELINE_STAGE_2_NONE : VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+        barriers[i].dstAccessMask = release ? 0 : VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT;
+        barriers[i].srcQueueFamilyIndex = release ? list->allocator->primary_pool.vk_family_index : VK_QUEUE_FAMILY_EXTERNAL;
+        barriers[i].dstQueueFamilyIndex = release ? VK_QUEUE_FAMILY_EXTERNAL : list->allocator->primary_pool.vk_family_index;
+        barriers[i].buffer = (VkBuffer)(uintptr_t)buffers[i].buffer;
+        barriers[i].offset = 0;
+        barriers[i].size = buffers[i].size;
+    }
+    d.bufferMemoryBarrierCount = n;
+    d.pBufferMemoryBarriers = barriers;
+    VK_CALL(vkCmdPipelineBarrier2(list->cmd.vk_command_buffer, &d));
+    return true;
+}
+
+static bool nr_ordered_dispatch_boundary(struct d3d12_command_list *list, UINT x, UINT y, UINT z)
+{
+    struct nr_ordered_api *api = nr_ordered_get_api();
+    const struct d3d12_root_signature *rs = list->compute_bindings.root_signature;
+    const struct vkd3d_shader_root_constant *c;
+    struct nr_ordered_snapshot *snapshot;
+    const char *hash_text, *reason = "shader/root signature shape";
+    uint64_t hash, token = 0, va = 0;
+    uint32_t mode = UINT32_MAX, frame = 0, spin_cap, reserved, iter, i;
+    char *end;
+
+    if (!api || !list->state || !d3d12_pipeline_state_is_compute(list->state))
+        return false;
+    hash_text = getenv("VKD3D_NR_FLAG_HASH");
+    if (!hash_text || !*hash_text)
+        return false;
+    hash = strtoull(hash_text, &end, 16);
+    if (*end || hash != UINT64_C(0x135ea1f88cbc832d) ||
+            hash != list->state->compute.code.meta.hash)
+        return false;
+    /* Do not emit thousands of identical errors for a rejected slice loop. */
+    if (d3d12_device_removed_reason(list->device) != S_OK)
+        return true;
+    if (!rs || rs->parameter_count != 3 || x != 1 || y != 1 || z != 1 ||
+            rs->parameters[0].parameter_type != D3D12_ROOT_PARAMETER_TYPE_UAV ||
+            rs->parameters[1].parameter_type != D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS ||
+            rs->parameters[2].parameter_type != D3D12_ROOT_PARAMETER_TYPE_UAV)
+        goto invalid;
+    c = &rs->parameters[1].constant;
+    if (c->constant_count != 4)
+        goto invalid;
+    mode = list->compute_bindings.root_constants[c->constant_index];
+    frame = list->compute_bindings.root_constants[c->constant_index + 1];
+    spin_cap = list->compute_bindings.root_constants[c->constant_index + 2];
+    reserved = list->compute_bindings.root_constants[c->constant_index + 3];
+    va = list->cmd.nr_flag_va;
+    reason = "unknown mode/constants or unregistered flags";
+    if (mode > 2 || reserved || !va || !list->cmd.nr_abort_va ||
+            api->lookup_va((uint64_t)(uintptr_t)list->device, va, &token))
+        goto invalid;
+
+    if (mode == 0)
+    {
+        reason = "new producer before finalizer or nonzero producer spin cap";
+        if (list->cmd.nr_wait_token || spin_cap)
+            goto invalid;
+        /* Execute the original producer stores. Startup producer-only probes
+         * are permitted; their command list is reset before a normal frame. */
+        list->cmd.nr_armed_token = token;
+        list->cmd.nr_armed_frame = frame;
+        list->cmd.nr_armed_flag_va = va;
+        list->cmd.nr_armed_abort_va = list->cmd.nr_abort_va;
+        return false;
+    }
+    reason = "frame or exact flags/abort address changed";
+    if (list->cmd.nr_armed_frame != frame || list->cmd.nr_armed_flag_va != va ||
+            list->cmd.nr_armed_abort_va != list->cmd.nr_abort_va)
+        goto invalid;
+
+    if (mode == 2)
+    {
+        reason = "finalizer without ordered consumer or nonzero spin cap";
+        if (list->cmd.nr_wait_token != token || list->cmd.nr_armed_token || spin_cap)
+            goto invalid;
+        /* v0.3.0 always emits this non-polling status shader after the waits.
+         * It checks the real HIP completion word and writes success/failure
+         * state. Keep it in the withheld consumer suffix, unchanged. */
+        list->cmd.nr_wait_token = 0;
+        list->cmd.nr_wait_spin_cap = 0;
+        if (nr_ordered_trace_allowed())
+            INFO("NRDIAG stage=record-finalizer list=%p token=%"PRIu64" frame=%u.\n",
+                    list, token, frame);
+        return false;
+    }
+    if (list->cmd.nr_wait_token)
+    {
+        reason = "repeated wait does not match the established consumer";
+        if (list->cmd.nr_wait_token != token || list->cmd.nr_armed_token ||
+                spin_cap != list->cmd.nr_wait_spin_cap)
+            goto invalid;
+        /* The pinned v0.3.0 binary records up to 4000 predicated Dispatches
+         * with identical wait constants. They are the SAME frame boundary,
+         * not additional producers. The first split already withholds this
+         * entire suffix until HIP completion; skip only these polling ops. */
+        return true;
+    }
+    reason = "wait without matching producer or unavailable command-list split";
+    if (list->cmd.nr_armed_token != token || !spin_cap ||
+            !d3d12_command_list_allows_new_sequence(list) ||
+            list->cmd.iteration_count >= VKD3D_MAX_COMMAND_LIST_SEQUENCES)
+        goto invalid;
+
+    reason = "snapshot allocation";
+    if (!(snapshot = vkd3d_calloc(1, sizeof(*snapshot))))
+        goto invalid;
+    reason = "shared-resource snapshot";
+    if (api->snapshot((uint64_t)(uintptr_t)list->device, snapshot->buffers,
+            NR_ORDERED_MAX_RESOURCES, &snapshot->count))
+    {
+        vkd3d_free(snapshot);
+        goto invalid;
+    }
+    /* Transfer pins to allocator before recording any raw Vulkan references.
+     * Even a subsequent recording failure keeps them until reset/free. */
+    snapshot->next = list->allocator->nr_snapshots;
+    list->allocator->nr_snapshots = snapshot;
+    for (i = 0; i < snapshot->count; ++i)
+        if (snapshot->buffers[i].token == token)
+            break;
+    if (i == snapshot->count)
+        goto invalid;
+    reason = "release barrier or command-list split";
+    d3d12_command_list_end_transfer_batch(list, true);
+    d3d12_command_list_end_current_render_pass(list, true);
+    if (!nr_ordered_memory_barrier(list, snapshot, true))
+        goto invalid;
+    iter = list->cmd.iteration_count;
+    d3d12_command_list_begin_new_sequence(list, false);
+    if (list->cmd.iteration_count != iter + 1)
+        goto invalid;
+    if (!nr_ordered_memory_barrier(list, snapshot, false))
+        goto invalid;
+    list->cmd.iterations[iter - 1].nr_after.nr_producer = (struct nr_ordered_endpoint){token, frame};
+    list->cmd.iterations[iter].nr_after.nr_consumer = (struct nr_ordered_endpoint){token, frame};
+    list->cmd.iterations[iter - 1].nr_after.snapshot = snapshot;
+    list->cmd.nr_armed_token = 0;
+    list->cmd.nr_wait_token = token;
+    list->cmd.nr_wait_spin_cap = spin_cap;
+    INFO("NR split token=%"PRIu64" frame=%u iteration=%u.\n", token, frame, iter);
+    nr_ordered_trace_list("record-split", list);
+    return true;
+invalid:
+    ERR("NR: cannot establish producer/consumer boundary: %s; list=%p mode=%u "
+            "token=%"PRIu64" frame=%u flags=%#"PRIx64".\n",
+            reason, list, mode, token, frame, va);
+    d3d12_device_mark_as_removed(list->device, DXGI_ERROR_INVALID_CALL,
+            "NR: cannot establish producer/consumer boundary; refusing unsafe dispatch.\n");
+    return true;
+}
+
+/* Validate/claim the union before even the first prefix in this Execute.
+ * Batches with overlapping snapshots cannot partially claim on conflict. */
+static bool nr_ordered_claim_submission(struct d3d12_command_queue *queue,
+        const struct d3d12_command_queue_submission_execute *exec)
+{
+    struct nr_buffer buffers[NR_ORDERED_MAX_RESOURCES];
+    struct nr_ordered_api *api;
+    uint32_t count = 0, i, j, k;
+    int rc;
+    if (d3d12_device_removed_reason(queue->device) != S_OK)
+    {
+        nr_ordered_trace_execute("claim-device-removed", queue, exec);
+        return false;
+    }
+    for (i = 0; exec->nr_boundaries && i < exec->cmd_count; ++i)
+    {
+        const struct nr_ordered_boundary *b = &exec->nr_boundaries[i];
+        if (!b->nr_producer.token)
+            continue;
+        if (!b->snapshot || !b->snapshot->count || b->snapshot->count > NR_ORDERED_MAX_RESOURCES)
+        {
+            ERR("NR: claim rejected invalid snapshot at command %u, token=%"PRIu64" frame=%u.\n",
+                    i, b->nr_producer.token, b->nr_producer.frame);
+            return false;
+        }
+        for (j = 0; j < b->snapshot->count; ++j)
+        {
+            const struct nr_buffer *buffer = &b->snapshot->buffers[j];
+            for (k = 0; k < count; ++k)
+                if (buffers[k].token == buffer->token)
+                    break;
+            if (k != count)
+                continue;
+            if (count == NR_ORDERED_MAX_RESOURCES)
+            {
+                ERR("NR: claim rejected snapshot union larger than %u resources.\n", NR_ORDERED_MAX_RESOURCES);
+                return false;
+            }
+            buffers[count++] = *buffer;
+        }
+    }
+    /* Ordinary game submissions must not take Wine's module/environment locks
+     * to resolve a bridge they do not use. Resolve only for an actual boundary. */
+    if (!count)
+        return true;
+    nr_ordered_queue_phase(queue, "claim-api", NULL, 0);
+    nr_ordered_trace_execute("claim-api-enter", queue, exec);
+    api = nr_ordered_get_api();
+    nr_ordered_queue_phase(queue, "claim-resources", NULL, 0);
+    nr_ordered_trace_execute("claim-api-return", queue, exec);
+    rc = api ? api->claim_queue(buffers, count, queue->nr_queue_id) : 1;
+    if (count && nr_ordered_trace_allowed())
+        INFO("NRDIAG stage=claim queue=%p id=%"PRIu64" buffers=%u result=%d.\n",
+                queue, queue->nr_queue_id, count, rc);
+    return !rc;
+}
+
+static VkResult nr_ordered_after_producer(struct d3d12_command_queue *queue,
+        const struct nr_ordered_boundary *full_boundary, uint64_t value)
+{
+    const struct nr_ordered_endpoint *boundary = &full_boundary->nr_producer;
+    const struct nr_ordered_snapshot *snapshot = full_boundary->snapshot;
+    const struct vkd3d_vk_device_procs *vk_procs = &queue->device->vk_procs;
+    struct nr_ordered_api *api = nr_ordered_get_api();
+    VkSemaphoreWaitInfo wait = { VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO };
+    VkResult vr;
+    int rc;
+    if (!api) return VK_ERROR_DEVICE_LOST;
+    if (nr_ordered_trace_allowed())
+        INFO("NRDIAG stage=prefix-wait queue=%p token=%"PRIu64" frame=%u timeline=%"PRIu64".\n",
+                queue, boundary->token, boundary->frame, value);
+    wait.semaphoreCount = 1;
+    wait.pSemaphores = &queue->vkd3d_queue->submission_timeline;
+    wait.pValues = &value;
+    /* Prefix is already submitted. The queue mutex is NOT held here.
+     * This cannot await work in the withheld consumer command buffer. */
+    vr = VK_CALL(vkWaitSemaphores(queue->device->vk_device, &wait, UINT64_C(2000000000)));
+    if (nr_ordered_trace_allowed())
+        INFO("NRDIAG stage=prefix-wait-return token=%"PRIu64" frame=%u result=%d.\n",
+                boundary->token, boundary->frame, vr);
+    if (vr != VK_SUCCESS)
+    {
+        api->fail(boundary->token, boundary->frame, 600);
+        return vr;
+    }
+    rc = snapshot ? api->publish_input(boundary->token, boundary->frame,
+            snapshot->buffers, snapshot->count) : 1;
+    if (nr_ordered_trace_allowed())
+        INFO("NRDIAG stage=publish-input token=%"PRIu64" frame=%u result=%d.\n",
+                boundary->token, boundary->frame, rc);
+    if (!rc) rc = api->wait_output(boundary->token, boundary->frame, 2000);
+    if (nr_ordered_trace_allowed())
+        INFO("NRDIAG stage=wait-output-return token=%"PRIu64" frame=%u result=%d.\n",
+                boundary->token, boundary->frame, rc);
+    if (rc)
+    {
+        ERR("NR: frame %u failed with %d; consumer NOT submitted.\n", boundary->frame, rc);
+        return VK_ERROR_DEVICE_LOST;
+    }
+    return VK_SUCCESS;
+}
