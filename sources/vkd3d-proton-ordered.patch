diff --git a/libs/vkd3d/swapchain.c b/libs/vkd3d/swapchain.c
index 7140f6c8..1b645e2e 100644
--- a/libs/vkd3d/swapchain.c
+++ b/libs/vkd3d/swapchain.c
@@ -687,7 +687,28 @@ static HRESULT STDMETHODCALLTYPE dxgi_vk_swap_chain_GetAdapter(IDXGIVkSwapChain2
 static HRESULT STDMETHODCALLTYPE dxgi_vk_swap_chain_GetDevice(IDXGIVkSwapChain2 *iface, REFIID riid, void **object)
 {
     struct dxgi_vk_swap_chain *chain = impl_from_IDXGIVkSwapChain(iface);
+    static uint32_t nr_queue_reported;
+    char nr_queue_compat[8];
+    HRESULT hr;
+
     TRACE("iface %p\n", iface);
+
+    /* NR v0.3.0 can observe the OptiScaler wrapper during CreateSwapChain
+     * and the underlying DXGI object during Present. Its queue-map lookup
+     * then misses and it asks GetDevice for ID3D12CommandQueue. Expose the
+     * queue actually owned by this swapchain only when explicitly enabled;
+     * never choose another queue from the device or change COM identity. */
+    if (IsEqualGUID(riid, &IID_ID3D12CommandQueue) &&
+            vkd3d_get_env_var("DLSSNR_SWAPCHAIN_QUEUE", nr_queue_compat, sizeof(nr_queue_compat)) &&
+            !strcmp(nr_queue_compat, "1"))
+    {
+        hr = ID3D12CommandQueue_QueryInterface((ID3D12CommandQueue *)&chain->queue->ID3D12CommandQueue_iface,
+                riid, object);
+        if (SUCCEEDED(hr) && !vkd3d_atomic_uint32_exchange_explicit(&nr_queue_reported, 1, vkd3d_memory_order_relaxed))
+            WARN("NR swapchain queue fallback enabled; returning this swapchain's own D3D12 queue.\n");
+        return hr;
+    }
+
     return ID3D12Device15_QueryInterface(&chain->queue->device->ID3D12Device_iface, riid, object);
 }
 
